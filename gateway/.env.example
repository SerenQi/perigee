# ─────────────────────────────────────────────────────────────
# Perigee gateway 环境变量
# 用法：cp .env.example .env，然后 node --env-file=.env server.js（Node 20.6+），或 systemd 的 EnvironmentFile=
#
# 分两种：
#   【部署】只能在这里改：网关监听在哪、数据放哪、Claude Code 在哪。
#   【兜底】前端「设置」里都能填（存服务器、不回显明文）。设置里填了就以设置为准，这里只是没填时的默认值。
# 全部可以留空。
# ─────────────────────────────────────────────────────────────

# ── 【部署】 ──
# 网关监听地址/端口。保持 127.0.0.1，只让反向代理（nginx）访问，别直接暴露到公网
PERIGEE_HOST=127.0.0.1
PERIGEE_PORT=3003
# 运行数据（聊天记录、图库、储物柜、设置、发件箱…）放哪；默认 gateway/data
PERIGEE_DATA_DIR=
# claude 命令的绝对路径（`which claude`）；不填就在 PATH 里找，systemd 下 PATH 很短，建议填
CLAUDE_BIN=
# Claude Code 的工作目录（它的 CLAUDE.md、项目记忆都跟着这个目录走）；默认运行用户的家目录
CLAUDE_CWD=
# 给每个会话挂的 MCP 配置文件（claude --mcp-config 格式），默认 data/mcp.json；前端「MCP 连接」页读写它。
# 文件不存在时，Claude Code 照常用你命令行里配好的全局 MCP；存在时每个房间只用这里列的
PERIGEE_MCP_CONFIG=
# Claude Code 的项目状态文件（MCP 停用列表在里面）；默认 ~/.claude.json
CLAUDE_JSON=
# Codex CLI（可选）
CODEX_BIN=
CODEX_CWD=
# edge-tts 命令路径（免费 TTS，pip install edge-tts）；默认在 PATH 里找
EDGE_TTS_BIN=
# 前端的公网地址，如 https://perigee.example.com/ （推送点开跳转、OpenRouter 的 Referer 用）
PERIGEE_PUBLIC_URL=
# 浏览器访问网关的路径前缀，要和前端 VITE_API_BASE 一致
PERIGEE_API_PUBLIC_BASE=/api
# 自动换窗：交接包/滚动摘要放哪（默认 gateway/data/forge）；剪切脚本路径（默认仓库附带的 tools/forge-reload/forge-reload.js）
FORGE_DIR=
FORGE_SCRIPT=

# ── 【兜底】名字 / 时区 / 会话（设置 › Claude 会话）──
PERIGEE_USER_NAME=
PERIGEE_AI_NAME=
# 例 Asia/Shanghai；默认跟服务器
PERIGEE_TZ=
PERIGEE_TURN_NOTE=
PERIGEE_HOME_API_DOC=
# default(每步询问) / acceptEdits / plan / bypassPermissions
PERIGEE_PERMISSION_MODE=default
# 1 = 开自动换窗
FORGE_ENABLED=
FORGE_SOFT_PCT=
FORGE_RETAIN=
FORGE_SQUASH=
# 涨落页的事件保留多少天（默认 30）
PERIGEE_EBB_KEEP_DAYS=
# 闲置多少分钟发一次缓存保活（会消耗额度），0/空 = 关
KEEPALIVE_MINUTES=
# 朋友圈自动回应这类一次性小活用的模型
PERIGEE_SIDE_MODEL=

# ── 【兜底】API 通道（设置 › 通道与 API）──
PERIGEE_ANTHROPIC_API_KEY=
PERIGEE_OPENROUTER_API_KEY=
PERIGEE_DEEPSEEK_API_KEY=
PERIGEE_OPENAI_API_KEY=

# ── 【兜底】声音与语音识别（设置 › 语音与通话）──
ELEVENLABS_API_KEY=
MOSI_API_KEY=
# 自建识别服务地址（POST 原始音频，返回 {"text": "..."}）
PERIGEE_ASR_URL=
# 填了就默认用 Gemini 识别 + 听语气
GEMINI_API_KEY=
# OpenAI 兼容的识别服务 key（在设置里选 OpenAI 兼容时用）
PERIGEE_ASR_API_KEY=

# ── 【兜底】生图（设置 › 生图 · 推送 · 群聊）──
# openai / openrouter
PERIGEE_DRAW_PROVIDER=
PERIGEE_DRAW_API_KEY=
PERIGEE_DRAW_BASE_URL=
PERIGEE_DRAW_MODEL=

# ── 【兜底】推送与群聊 ──
# 完整的 Bark 地址 https://api.day.app/你的设备key
BARK_URL=
# 0 = 暂停推送
BARK_PUSH=
# mousecrew 群聊后端（网关在服务器上能访问到的地址）
MOUSECREW_URL=
MOUSECREW_TOKEN=
